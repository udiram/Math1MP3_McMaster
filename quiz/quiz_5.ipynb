   "source": [
    "# The coefficients of a polynomial p(x)  =  a0 + a1x + a2x2 + ⋯ + anxn are given as a python list pol=[a0, a1, a2, ... , an], where the index corresponds to the power of x.\n",
    "def evaluate(p,a):\n",
    "    pa=0\n",
    "    for k in range(len(p)):\n",
    "        pa+=p[k]*a**k\n"
   ]
  }
